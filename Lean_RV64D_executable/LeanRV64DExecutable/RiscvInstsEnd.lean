def assembly_forwards_matches (arg_ : ast) : Bool :=
  match arg_ with
  | .UTYPE (imm, rd, op) => true
  | .JAL (imm, rd) => true
  | .JALR (imm, rs1, rd) => true
  | .BTYPE (imm, rs2, rs1, op) => true
  | .ITYPE (imm, rs1, rd, op) => true
  | .SHIFTIOP (shamt, rs1, rd, op) => true
  | .RTYPE (rs2, rs1, rd, op) => true
  | .LOAD (imm, rs1, rd, is_unsigned, width, aq, rl) => true
  | .STORE (imm, rs2, rs1, width, aq, rl) => true
  | .ADDIW (imm, rs1, rd) =>
    (bif (xlen == 64)
    then true
    else false)
  | .RTYPEW (rs2, rs1, rd, op) =>
    (bif (xlen == 64)
    then true
    else false)
  | .SHIFTIWOP (shamt, rs1, rd, op) =>
    (bif (xlen == 64)
    then true
    else false)
  | .FENCE (pred, succ) => true
  | .FENCE_TSO () => true
  | .ECALL () => true
  | .MRET () => true
  | .SRET () => true
  | .EBREAK () => true
  | .WFI () => true
  | .SFENCE_VMA (rs1, rs2) => true
  | .FENCEI () => true
  | .AMO (op, aq, rl, rs2, rs1, width, rd) => true
  | .LOADRES (aq, rl, rs1, size, rd) => true
  | .STORECON (aq, rl, rs2, rs1, size, rd) => true
  | .C_NOP () => true
  | .C_ADDI4SPN (rdc, nzimm) =>
    (bif (nzimm != (0x00 : (BitVec 8)))
    then true
    else false)
  | .C_LW (uimm, rsc, rdc) => true
  | .C_LD (uimm, rsc, rdc) =>
    (bif (xlen == 64)
    then true
    else false)
  | .C_SW (uimm, rsc1, rsc2) => true
  | .C_SD (uimm, rsc1, rsc2) =>
    (bif (xlen == 64)
    then true
    else false)
  | .C_ADDI (nzi, rsd) =>
    (bif ((nzi != (0b000000 : (BitVec 6))) && (bne rsd zreg))
    then true
    else false)
  | .C_JAL imm =>
    (bif (xlen == 32)
    then true
    else false)
  | .C_ADDIW (imm, rsd) =>
    (bif (xlen == 64)
    then true
    else false)
  | .C_LI (imm, rd) =>
    (bif (bne rd zreg)
    then true
    else false)
  | .C_ADDI16SP imm =>
    (bif (imm != (0b000000 : (BitVec 6)))
    then true
    else false)
  | .C_LUI (imm, rd) =>
    (bif ((bne rd zreg) && ((bne rd sp) && (imm != (0b000000 : (BitVec 6)))))
    then true
    else false)
  | .C_SRLI (shamt, rsd) =>
    (bif (shamt != (0b000000 : (BitVec 6)))
    then true
    else false)
  | .C_SRAI (shamt, rsd) =>
    (bif (shamt != (0b000000 : (BitVec 6)))
    then true
    else false)
  | .C_ANDI (imm, rsd) => true
  | .C_SUB (rsd, rs2) => true
  | .C_XOR (rsd, rs2) => true
  | .C_OR (rsd, rs2) => true
  | .C_AND (rsd, rs2) => true
  | .C_SUBW (rsd, rs2) =>
    (bif (xlen == 64)
    then true
    else false)
  | .C_ADDW (rsd, rs2) =>
    (bif (xlen == 64)
    then true
    else false)
  | .C_J imm => true
  | .C_BEQZ (imm, rs) => true
  | .C_BNEZ (imm, rs) => true
  | .C_SLLI (shamt, rsd) =>
    (bif ((shamt != (0b000000 : (BitVec 6))) && (bne rsd zreg))
    then true
    else false)
  | .C_LWSP (uimm, rd) =>
    (bif (bne rd zreg)
    then true
    else false)
  | .C_LDSP (uimm, rd) =>
    (bif ((bne rd zreg) && (xlen == 64))
    then true
    else false)
  | .C_SWSP (uimm, rs2) => true
  | .C_SDSP (uimm, rs2) =>
    (bif (xlen == 64)
    then true
    else false)
  | .C_JR rs1 =>
    (bif (bne rs1 zreg)
    then true
    else false)
  | .C_JALR rs1 =>
    (bif (bne rs1 zreg)
    then true
    else false)
  | .C_MV (rd, rs2) =>
    (bif ((bne rd zreg) && (bne rs2 zreg))
    then true
    else false)
  | .C_EBREAK () => true
  | .C_ADD (rsd, rs2) =>
    (bif ((bne rsd zreg) && (bne rs2 zreg))
    then true
    else false)
  | .MUL (rs2, rs1, rd, mul_op) => true
  | .DIV (rs2, rs1, rd, s) => true
  | .REM (rs2, rs1, rd, s) => true
  | .MULW (rs2, rs1, rd) =>
    (bif (xlen == 64)
