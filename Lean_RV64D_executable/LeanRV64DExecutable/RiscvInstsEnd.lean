  | .CSRImm (csr, imm, rd, op) => true
  | .CSRReg (csr, rs1, rd, op) => true
  | .C_NOP_HINT imm => true
  | .C_ADDI_HINT rsd =>
    (bif (bne rsd zreg)
    then true
